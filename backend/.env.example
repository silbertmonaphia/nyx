# Backend runtime config — consumed by the nyx Go service.
#
# In local dev: `scripts/dev.sh` sources this file (`backend/.env`)
# before spawning `go run ./cmd/api`, so viper picks the values up
# from the process env regardless of the backend's CWD.
#
# In Docker: the backend service in `docker-compose.yml` mounts this
# via `env_file: backend/.env`, which makes the values available
# inside the container at runtime.
#
# Copy to `backend/.env` and fill in. Never commit `backend/.env`
# (it's in `.gitignore`).


# --- Required (no safe default — must be set) ---------------------------

# JWT_SECRET — HS256 signing key for access + refresh tokens.
# config.Load() refuses the built-in default
# ("your-default-secret-key-change-it-in-prod") and any key shorter
# than 32 bytes (auth.MinSecretBytes, RFC 7518 §3.2). Generate with:
#   openssl rand -base64 48
# Rotate by changing this var and restarting the backend — all
# previously issued tokens are invalidated. Never commit a real
# value; the pre-commit gitleaks hook will block the push.
JWT_SECRET=


# --- Database -----------------------------------------------------------

# In-network hostname for compose (`db` resolves via the bridge DNS).
# `scripts/dev.sh` overrides this to 127.0.0.1:5433 (host-mapped port)
# before spawning the backend locally, since `db` only resolves from
# inside the compose network.
DB_URL=postgres://postgres:postgres@db:5432/nyx?sslmode=disable

# Connection pool tuning (defaults shown — uncomment to override)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=1h
# DB_CONN_MAX_IDLE_TIME=30m

# Migrations
# MIGRATION_PATH=file://migrations

# Server
# PORT=8080


# --- Cache (off by default — set REDIS_ENABLED=true to turn on) ---------

# REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379
# CACHE_TTL=5m


# --- CORS — deny-by-default ---------------------------------------------

# Empty (default) blocks every cross-origin request from a browser.
# Set this to the explicit comma-separated list of frontend origins
# allowed to call the API. Bearer is a regular Authorization header
# (not a credential), so ACAC is NOT needed; the cross-origin
# preflight is the CSRF defence.
# Dev (Vite on :5173, backend on :8080):
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Prod:
# CORS_ALLOWED_ORIGINS=https://app.nyx.com


# --- JWT TTLs (defaults shown — uncomment to override) ------------------

# Access is intentionally short (15m default) so a stolen access token
# is replaced within one rotation cycle of any active refresh token;
# refresh is the long-lived bearer (168h = 7d default).
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h


# --- Go module proxy (backend build-time only) --------------------------

# Override if proxy.golang.org is slow from your network. Common
# alternatives: https://goproxy.cn (China), https://goproxy.io (Asia).
# The backend Dockerfile defaults to https://proxy.golang.org,direct
# when GOPROXY isn't passed at build time.
# GOPROXY=https://goproxy.cn,direct


# --- OpenTelemetry — distributed tracing via OTLP/HTTP → Jaeger --------

# Off by default; uncommenting OTEL_ENABLED turns on the OTel SDK
# so spans flow into the local Jaeger UI. Jaeger UI:
# http://localhost:16686 — see README.md "OpenTelemetry (optional)".
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_SERVICE_NAME=nyx-backend


# --- LLM / chat (off by default — uncomment LLM_ENABLED=true) ---------

# Defaults below are set in code; only override what you need.
# WARNING: never commit real keys; the pre-commit gitleaks hook will
# block the push.
#
# LLM_PROVIDER picks the PRIMARY client implementation:
#   openai  — sashabaranov/go-openai SDK. Works against OpenAI proper
#             (https://api.openai.com/v1) and any OpenAI-compatible
#             server via base URL alone.
#   vllm    — raw net/http + hand-rolled SSE decoder for self-hosted
#             vLLM. Per-dial IP-class allowlist; empty LLM_API_KEY
#             allowed (vLLM started without --api-key accepts any
#             Authorization header, including none).
# The chat domain consumes both through the same llm.Provider
# interface — switching is a config change, no rebuild.
# LLM_ENABLED=true
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-prod-...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60s
# LLM_MAX_TOKENS=1024
# LLM_MAX_HISTORY_MESSAGES=50
# LLM_MAX_MESSAGE_CHARS=32768
# LLM_MAX_STREAM_DURATION=10m
# LLM_SYSTEM_PROMPT=You are a helpful assistant for a movie catalog.
#
# LLM_ALLOW_PRIVATE_URL relaxes the SSRF guard on LLM_BASE_URL
# (loopback / RFC1918 / link-local / multicast / unspecified are
# refused by default). Required when LLM_BASE_URL points at a
# private hostname (dev compose's vLLM container on the bridge
# network, internal staging endpoints). Set to false in prod
# unless you control the upstream network. The same flag covers
# the fallback URL below.
# LLM_ALLOW_PRIVATE_URL=false
#
# --- Failover (optional — leave LLM_FALLBACK_BASE_URL empty to disable)
#
# Setting LLM_FALLBACK_BASE_URL enables llm.Router: every chat
# request probes the primary (GET {base}/v1/models) and, on probe
# failure OR mid-stream provider error, replays the request on the
# fallback with the partial reply appended. The fallback's
# provider type is implicit (the OPPOSITE of LLM_PROVIDER —
# openai ↔ vllm). LLM_FALLBACK_MODEL defaults to LLM_MODEL when
# empty. LLM_PROBE_TIMEOUT caps the per-request probe (default 2s);
# keep it well under LLM_TIMEOUT.
#
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# LLM_PROBE_TIMEOUT=2s

# --- Separate embedding endpoint (optional — leave empty to reuse chat) -
#
# Most chat-tuned models (Qwen3-4B / Qwen3-8B-FP8 / Llama / Mistral /
# GPT-OSS) do not expose /v1/embeddings — the Nyx embedder would hit a
# 404 and feed_embeddings would stay empty. The dedicated embed
# endpoint slot solves this: when LLM_EMBEDDING_BASE_URL is set, the
# rag package builds a separate client and the embed model id is sent
# to the embed server.
#
# Resolution rules (validated by config.go validateLLMConfig):
#   * LLM_EMBEDDING_PROVIDER  — empty → fall back to LLM_PROVIDER.
#   * LLM_EMBEDDING_BASE_URL  — empty → embedder reuses the chat
#     provider (single-model deployment; today's behaviour).
#     Non-empty → dedicated client is built and chat provider is
#     NOT used for embeddings.
#   * LLM_EMBEDDING_API_KEY   — empty → fall back to LLM_API_KEY.
#   * LLM_EMBEDDING_ALLOW_PRIVATE_URL — empty → fall back to
#     LLM_ALLOW_PRIVATE_URL. Required for compose where vllm-embed
#     is a private DNS name on the bridge network.
#   * LLM_EMBEDDING_MODEL must be EXPLICIT when BASE_URL is set
#     (no fallback to LLM_MODEL — the embed endpoint serves a
#     different model id).
#
# The compose file (--profile embed) ships a vllm-embed service
# running Qwen/Qwen3-Embedding-0.6B on host port 8001; the URL
# below uses the in-network hostname for backend → vllm-embed.
#
# NOTE: do NOT add a /v1 suffix. The vLLM client appends the full
# path /v1/embeddings to whatever you set here (internal/llm/vllm/
# client.go:376). The chat client (line 145) only appends
# /chat/completions, which is why LLM_BASE_URL above does need
# its trailing /v1 — the asymmetry is intentional in the client
# today but trips every new operator. Host-path example: use
# http://localhost:8001 (no /v1); compose example below uses the
# in-network hostname.
#
# LLM_EMBEDDING_PROVIDER=vllm
# LLM_EMBEDDING_BASE_URL=http://vllm-embed:8000
# LLM_EMBEDDING_API_KEY=
# LLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# LLM_EMBEDDING_ALLOW_PRIVATE_URL=true
# EMBEDDING_DIMENSIONS=1024

# --- MCP server (off by default — uncomment MCP_ENABLED=true) -------
#
# Exposes the feed domain (list/get/create/update/delete) to external
# AI agents over the Model Context Protocol (Streamable HTTP transport,
# JSON-RPC 2.0 envelope). Auth: same JWT bearer used by the REST API.
# Per-owner scoping enforced inside feed.Service — single
# feed.ErrNotFound sentinel for missing OR cross-owner, no existence
# leak. Tools only — no Resources, no Prompts. Default-off so
# deployments without external agents pay zero allocation. See
# FUTURE_BACKEND.md §11.
#
# MCP_ENABLED=true
# MCP_PATH=/mcp
# MCP_MAX_BODY_BYTES=65536
