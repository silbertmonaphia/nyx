# Python agent service runtime config — consumed by `agent.config.Settings`.
# Copy to `.env` and fill in. Never commit `.env` (it's in `.gitignore`).

# --- Server ---------------------------------------------------------------
# FastAPI listen port (UI/healthz/SSE).
PYTHON_AGENT_PORT=9000
# Prometheus exporter port (Python agent metrics — scrapes independently of Go).
PYTHON_AGENT_METRICS_PORT=9001
# Shared service credential, intentionally unprefixed so the Go backend
# reads the same name from backend/.env. Required (at least 32 bytes) —
# the service refuses to start without it. Generate with:
#   openssl rand -hex 32
# AGENT_SERVICE_TOKEN=


# --- LLM ------------------------------------------------------------------
# OpenAI-compatible base URL. Works against OpenAI proper or any
# OpenAI-compatible server (vLLM, OpenRouter, etc).
PYTHON_AGENT_LLM_BASE_URL=http://127.0.0.1:8000/v1
# API key (empty OK for vLLM started without --api-key).
PYTHON_AGENT_LLM_API_KEY=
# Default chat model. Used by the planner + llm steps.
PYTHON_AGENT_LLM_MODEL=gpt-4o-mini
# Optional planner model override. Set to a smaller/cheaper model so the
# one-shot plan call amortises against the executor step calls. Empty
# falls back to PYTHON_AGENT_LLM_MODEL.
PYTHON_AGENT_LLM_PLANNER_MODEL=


# --- Plan / step caps (defaults shown) ------------------------------------
PYTHON_AGENT_PLAN_MAX_STEPS=10
PYTHON_AGENT_STEP_REACT_MAX_ITERATIONS=5

# --- Planner robustness (openspec/changes/agent-planner-structured) -------
# When true (default), the planner binds the OpenAI `response_format`
# json_schema explicitly (`strict: false` — the free-form `PlanStep.args`
# object is unrepresentable in strict mode) and parses the
# schema-constrained content JSON through Pydantic, instead of parsing
# free-text model output with `json.loads`/fence-stripping. Set false to
# drop back to the legacy free-text path (e.g. for vLLM running with a
# parser that doesn't honour `response_format`).
# PYTHON_AGENT_PLANNER_STRUCTURED_ENABLED=true
# Maximum retries on a Pydantic validation failure from the planner.
# 0 = no retry (single attempt). Default 1: one re-prompt with the
# validator's error appended under a `PREVIOUS_ATTEMPT_FAILED` block
# before terminating with `error{code:"plan_invalid"}`. Negative
# values refuse startup.
# PYTHON_AGENT_PLANNER_RETRY_MAX=1


# --- Tool-dispatch robustness (openspec/changes/agent-tool-dispatch-retry) -
# Maximum retries on a tool-dispatch failure from the executor.
# Covers two failure classes: registry-rejected tool calls
# (Pydantic validation, missing required field, wrong type) and
# transient errors from the tool's remote call (network, MCP /
# RAG bridge timeouts, 5xx, 408, 429). 0 = no retry (single attempt).
# Negative values refuse startup. Budget is per-step and per-tool —
# exhaustion in step A does not consume budget in step B.
# PYTHON_AGENT_TOOL_RETRY_MAX=2
# Base backoff between retries on transient tool-execution errors.
# Effective sleep is `min(base * 2^attempt + jitter, ceiling)` with
# jitter ±20%. Only the transient path uses backoff; the
# validator-feedback path re-prompts the model immediately. Integer
# milliseconds to keep the retry-loop math round.
# PYTHON_AGENT_TOOL_RETRY_BACKOFF_BASE_MS=250
# Hard ceiling on the per-attempt backoff sleep. Cumulative wall-clock
# across the step's transient retries is bounded by
# `tool_retry_max * ceiling`; the step's overall timeout is enforced
# by the existing AGENT_STEP_TIMEOUT semantics, not by the retry loop.
# PYTHON_AGENT_TOOL_RETRY_BACKOFF_CEILING_MS=5000


# --- Web tools (openspec/changes/agent-web-tools) --------------------------
# Two agent-native tools (web_fetch / web_search) dispatched through the
# same retry funnel as the MCP registry tools. Both default OFF; with them
# off the merged tool list equals the MCP registry list and the planner
# prompt is byte-identical to its pre-web-tools form.
# web_fetch is SSRF-guarded (deny-list on every resolved address + the
# connection pinned to the validated address); web_search uses Tavily —
# keyless by default (no account, rate-limited), or set the optional
# card-free key (1k searches/month) to raise the limits.
# PYTHON_AGENT_WEB_FETCH_ENABLED=false
# PYTHON_AGENT_WEB_SEARCH_ENABLED=false
# PYTHON_AGENT_TAVILY_API_KEY=
# Overridden by tests/e2e to point the search tool at a stub.
# PYTHON_AGENT_TAVILY_BASE_URL=https://api.tavily.com/search
# Results per search (hard cap 10).
# PYTHON_AGENT_WEB_SEARCH_MAX_RESULTS=5
# Response byte cap, streamed — an oversized body never fully enters memory.
# PYTHON_AGENT_WEB_FETCH_MAX_BYTES=2097152
# Request timeout (also used for the search provider call).
# PYTHON_AGENT_WEB_FETCH_TIMEOUT_SECONDS=10
# Extracted-text cap, with truncation marker.
# PYTHON_AGENT_WEB_FETCH_MAX_CHARS=20000
# Redirect hop cap; every hop re-validated by the SSRF guard.
# PYTHON_AGENT_WEB_FETCH_MAX_REDIRECTS=5
# Dev/e2e escape hatch: lifts the private-address deny-list AND the 80/443
# port rule so fetches can reach local fixture servers. Logged loudly at
# startup. NEVER enable in a deployed environment.
# PYTHON_AGENT_WEB_FETCH_ALLOW_PRIVATE=false
# Same escape hatch for the search provider's deployment-configured endpoint
# (PYTHON_AGENT_TAVILY_BASE_URL) — required when that URL is a loopback stub
# (evals bind 127.0.0.1:8890). Does NOT affect BYOK-supplied endpoints.
# PYTHON_AGENT_WEB_SEARCH_ALLOW_PRIVATE=false
# Escape hatch for BYOK-supplied endpoints: the chat LLM
# (llm_config.base_url, dialled by ChatOpenAI) and the Tavily search
# override (tavily_config.base_url). Single-operator instances only (e.g. the
# form pointing at a loopback vLLM); multi-tenant deployments must leave it
# off. Deployment-configured endpoints are never affected by this flag.
# PYTHON_AGENT_BYOK_ALLOW_PRIVATE=false


# --- Backend bridges ------------------------------------------------------
# Host-dev defaults (backend runs on the host via `make dev-backend`).
# Do NOT set the compose hostnames here (`backend:8080`) — they only
# resolve inside the compose network; docker-compose.yml sets them
# explicitly for the agent container.
# MCP JSON-RPC endpoint (Go chat handler's MCP shim — tools/call).
# PYTHON_AGENT_MCP_URL=http://localhost:8080/mcp
# RAG bridge endpoint (Go rag.Service.Retrieve over HTTP).
# PYTHON_AGENT_RAG_BRIDGE_URL=http://localhost:8080/internal/rag/retrieve


# --- Redis ---------------------------------------------------------------
# Host-dev default; the host-mapped port is 6380 (compose maps 6380->6379).
# PYTHON_AGENT_REDIS_URL=redis://localhost:6380


# --- OpenTelemetry -------------------------------------------------------
# Jaeger span export is on by default. Set PYTHON_AGENT_OTEL_ENABLED=false to
# skip the Jaeger OTLP exporter entirely (and with it the background retry
# diagnostics) when no collector is running. Langfuse tracing is unaffected.
# PYTHON_AGENT_OTEL_ENABLED=true
# OTLP/HTTP endpoint. Default (localhost:4318) targets Jaeger on the host
# so `make dev-agent` works out of the box — Jaeger publishes 4318 on the
# host. Do NOT set the compose hostname here: it only resolves inside the
# compose network. The compose agent service sets
# PYTHON_AGENT_OTEL_ENDPOINT=http://jaeger:4318 explicitly.
# PYTHON_AGENT_OTEL_ENDPOINT=http://localhost:4318
PYTHON_AGENT_OTEL_SERVICE_NAME=nyx-agent


# --- Per-IP rate limit (defense in depth for the no-auth /agent/run hop
# — see README "Trust model"). Generous enough that a single Go
# backend instance never trips; tight enough that a compromised
# container on the same bridge network can't drain the LLM budget.
PYTHON_AGENT_REQUESTS_PER_SECOND=100
PYTHON_AGENT_BURST=200


# --- Per-user token budget -----------------------------------------------
# Unprefixed env var is shared with Go side historically per FUTURE_AGENT.md.
# Python reads it directly (not via pydantic-settings).
AGENT_BUDGET_PER_USER_PER_HOUR=200000


# --- Auth note ------------------------------------------------------------
# The Python agent service does NOT verify JWTs. It runs on the private
# compose / k8s network and trusts that only the Go backend can reach it.
# Go verifies the user JWT at the SPA edge and forwards the verified user
# id via the `X-Nyx-User-Id` header; the bearer token is forwarded as a
# passthrough to /mcp and /internal/rag/retrieve (Go re-verifies on those
# endpoints). See FUTURE_AGENT.md + docker-compose.yml for the trust model.


# --- Run-state persistence (Postgres via langGraph PostgresSaver + thin
# `agent.runs` metadata table — see openspec/changes/agent-run-state/).
# Required when AGENT_ENABLED=true. DSN MUST include
# `options=-c search_path=langgraph,agent`.
# Leave unset (default empty) to disable run-state persistence — useful
# for local dev without Postgres.
#
# PYTHON_AGENT_DATABASE_URL=postgresql://nyx:nyx@db:5432/nyx?options=-c search_path=langgraph,agent

# Retention cron — deletes terminal agent.runs rows older than N days.
# For each deleted run the cron also deletes the run's langGraph
# checkpoint thread (adelete_thread); langGraph ships no retention
# story of its own, so this is the only path that prunes
# langgraph.checkpoint_*.
# PYTHON_AGENT_RETENTION_ENABLED=true
# PYTHON_AGENT_RETENTION_DAYS=30
# PYTHON_AGENT_RETENTION_INTERVAL_SECONDS=3600

# Chat-history retention (openspec/changes/agent-chat-history-storage) —
# soft-deletes `agent.chat_sessions` rows past `CHAT_RETENTION_DAYS`
# and hard-deletes them after `CHAT_RETENTION_GRACE_DAYS`. Floor of
# 365 days (one year) is enforced at startup — refusing values < 365.
# The cron uses two phases (soft-delete + grace) so Slice 4 (GDPR
# export/erase) can read soft-deleted state before it's physically
# removed. `CHAT_RETENTION_ENABLED=false` halts the chat iteration
# without affecting run retention.
# PYTHON_AGENT_CHAT_RETENTION_DAYS=365
# PYTHON_AGENT_CHAT_RETENTION_GRACE_DAYS=7
# PYTHON_AGENT_CHAT_RETENTION_ENABLED=true

# Chat-session REST surface (openspec/changes/agent-chat-history-ui) —
# the sidebar's list/replay/create/resume/delete endpoints under
# /agent/sessions. Page size is the default for GET /agent/sessions;
# per-request `limit` overrides it, hard-capped at 50.
# PYTHON_AGENT_SESSIONS_PAGE_SIZE=10

# Stale-run sweeper (openspec/changes/agent-stale-run-sweeper) — reaps
# zombie `running` rows left by a crashed / killed agent process. While
# a run streams, a background task touches its `last_heartbeat_at`
# every HEARTBEAT_INTERVAL_SECONDS. Rows still `running` with a
# heartbeat older than STALE_RUN_TIMEOUT_SECONDS are marked
# failed/stale_run. The timeout doubles as the window in which a
# crashed run can still be resumed by echoing its run_id (after
# reaping: fresh run). MUST be >= 2x the heartbeat interval (startup
# refuses otherwise). SWEEP_ENABLED=false is the rollback switch — it
# stops reaping while heartbeats keep writing. Reaped runs' checkpoint
# threads are NOT deleted at reap; retention collects them with the row.
# PYTHON_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
# PYTHON_AGENT_STALE_RUN_TIMEOUT_SECONDS=900
# PYTHON_AGENT_SWEEP_INTERVAL_SECONDS=300
# PYTHON_AGENT_SWEEP_ENABLED=true

# --- Langfuse LLM tracing (openspec/changes/agent-langfuse-tracing) ------
# Opt-in export of LLM-level traces (prompts, replies, token usage, tool
# calls) to the self-hosted Langfuse stack (`make dev-up-langfuse`, UI on
# http://localhost:3000). Default off — when false, no client is
# constructed and nothing leaves the process. Enabling without the key
# pair below refuses startup.
#
# The key pair MUST match the LANGFUSE_INIT_PROJECT_* values in the
# ROOT `.env` (docker-compose.yml feeds them to the langfuse-web
# first-boot bootstrap); the dev defaults live in the root `.env.example`.
# Host-dev default for HOST matches the published port; the compose
# agent service overrides it with http://langfuse-web:3000.
# PYTHON_AGENT_LANGFUSE_ENABLED=false
# PYTHON_AGENT_LANGFUSE_HOST=http://localhost:3000
# PYTHON_AGENT_LANGFUSE_PUBLIC_KEY=pk-lf-nyx-dev-agent
# PYTHON_AGENT_LANGFUSE_SECRET_KEY=sk-lf-nyx-dev-agent

# Asyncpg pool sizing. Exceeding the acquire timeout translates to
# error{code:"run_metadata_unavailable"} and the run continues.
# PYTHON_AGENT_DATABASE_POOL_MAX_SIZE=10
# PYTHON_AGENT_DATABASE_POOL_ACQUIRE_TIMEOUT_SECONDS=5.0

# When true, skip the inline `alembic upgrade head` on lifespan startup.
# Default false — alembic runs automatically on agent boot, matching the
# Go backend's golang-migrate posture (one command = migrations + serve).
# Compose prod sets this true and relies on the dedicated `agent-migrate`
# one-shot service instead.
# PYTHON_AGENT_MIGRATIONS_DISABLED=false
# User preferences (openspec/changes/agent-user-preferences) — after a
# reply completes, a fire-and-forget task extracts stated preferences
# from the turn's last user message (conservative EN/ZH gate; never
# charged to the chat budget) and upserts them per (user_id, key). The
# planner prompt gains a "Known user preferences" block; with zero
# prefs the prompt is byte-identical to the pre-injection form.
# PREFS_ENABLED=false is the rollback switch (disables extraction AND
# injection together); PREFS_MAX_INJECTED bounds the block (top-N by
# updated_at DESC; negative refuses startup).
# PYTHON_AGENT_PREFS_ENABLED=true
# PYTHON_AGENT_PREFS_MAX_INJECTED=50

# GDPR data-subject endpoints (openspec/changes/agent-gdpr-compliance) —
# GET /agent/me/export (full JSON dump of the subject's rows) and
# DELETE /agent/me (physical erasure: chat sessions/messages, prefs,
# runs, then the langGraph checkpoint threads — the deduped union of run
# ids (single-turn) and session ids (continuation turns are
# session-keyed), because each thread id is the unit of erasure). Both are
# owner-scoped via the Go-verified X-Nyx-User-Id header (missing /
# non-integer -> 400; no admin override). GDPR_ENABLED=false is the
# kill switch: both endpoints return 503 and touch nothing (no read, no
# write, no audit row) — while the audit-retention sweep below keeps
# running either way, so the trail still expires on schedule.
# AUDIT_RETENTION_DAYS is the agent.data_audit_log window (default 1095
# = 3 years — the erase/export evidence outlives the 1-year data
# retention on purpose); values below 365 refuse startup.
# PYTHON_AGENT_GDPR_ENABLED=true
# PYTHON_AGENT_AUDIT_RETENTION_DAYS=1095

# ---------------------------------------------------------------------------
# Mutating-call approval TTL (openspec/changes/agent-feed-tools) —
# PYTHON_AGENT_APPROVAL_TTL_SECONDS is the wall-clock window a paused
# mutating-call confirmation (the chat's approve/deny card) stays open
# before the call closes as denied. Default 300; MUST be >= 1 — refuses
# to start below (validator). Decisions are brokered through Redis, so
# the gate is live whenever PYTHON_AGENT_REDIS_URL is configured;
# without Redis every mutating call closes as denied (fail-closed).
#
# PYTHON_AGENT_APPROVAL_TTL_SECONDS=300
