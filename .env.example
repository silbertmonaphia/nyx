# --- Required (no safe default — must be set) ---------------------------
#
# These are read at startup; the backend refuses to boot (or the vLLM
# container aborts model load) if they're empty. Copy to .env and fill in.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nyx
DB_URL=postgres://postgres:postgres@db:5432/nyx?sslmode=disable

# Auth — Bearer tokens in JSON body. No cookies, no SameSite, no
# __Host- prefix. The /api/login, /api/register, /api/refresh,
# /api/logout endpoints return {access_token, refresh_token,
# token_type: "Bearer", expires_at, user} in the body; every other
# endpoint expects Authorization: Bearer <access_token>. Native
# clients (iOS / Android / Unity / Unreal / console SDKs) speak the
# identical wire contract.
#
# JWT_SECRET — REQUIRED. HS256 signing key for access + refresh
# tokens. config.Load() refuses the built-in default
# ("your-default-secret-key-change-it-in-prod") and any key shorter
# than 32 bytes (auth.MinSecretBytes, RFC 7518 §3.2). Generate with:
#   openssl rand -base64 48
# Rotate by changing this var and restarting the backend — all
# previously issued tokens are invalidated. Never commit a real
# value; the pre-commit gitleaks hook will block the push.
JWT_SECRET=

# HuggingFace — REQUIRED for the --profile vllm container. HF's CAS
# endpoint (cas-server.xethub.hf.co) demands a token for all weight
# downloads, even ungated models like the default
# Qwen3-4B-Instruct-2507. Generate at
# https://huggingface.co/settings/tokens (read role is enough).
HUGGING_FACE_HUB_TOKEN=


# --- Optional / has safe defaults (uncomment to override) --------------

# Cache (off by default — set REDIS_ENABLED=true to turn on).
# REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379
# CACHE_TTL=5m

# Go module proxy. Override if proxy.golang.org is slow from your
# network. Common alternatives: https://goproxy.cn (China),
# https://goproxy.io (Asia). Defaults to proxy.golang.org.
# GOPROXY=https://goproxy.cn,direct

# CORS — deny-by-default. Empty (default) blocks every cross-origin
# request from a browser. Set this to the explicit comma-separated
# list of frontend origins allowed to call the API. Bearer is a
# regular Authorization header (not a credential), so ACAC is NOT
# needed; the cross-origin preflight is the CSRF defence.
# Dev (Vite on :5173, backend on :8080):
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Prod:
# CORS_ALLOWED_ORIGINS=https://app.nyx.com

# Frontend → backend origin (cross-origin in production). Baked into
# the SPA bundle at image-build time as VITE_API_URL and into the
# nginx CSP via __API_ORIGIN__. Frontend falls back to
# http://localhost:8080/api in dev when VITE_API_URL is unset.
# VITE_API_URL=https://api.nyx.com/api
# API_ORIGIN=https://api.nyx.com

# OpenTelemetry — distributed tracing via OTLP/HTTP → Jaeger. Off by
# default; uncommenting OTEL_ENABLED + VITE_OTEL_ENABLED enables a
# complete trace path. Jaeger UI: http://localhost:16686 — see
# README.md "OpenTelemetry (optional)".
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_SERVICE_NAME=nyx-backend
# VITE_OTEL_ENABLED=true
# VITE_OTEL_SERVICE_NAME=nyx-frontend
# JAEGER_HOST=jaeger

# Sentry — frontend error / performance / replay sink. Backend stays
# on OTel→Jaeger (see SENTRY.md). VITE_SENTRY_DSN is inlined into the
# SPA bundle at image build time; SENTRY_AUTH_TOKEN / SENTRY_ORG /
# SENTRY_PROJECT are build-time only — consumed by @sentry/vite-plugin
# for sourcemap upload and never shipped to the bundle. Leave the
# three build-time vars empty for local dev builds without upload.
# SENTRY_CSP_ORIGIN is baked into the nginx CSP connect-src directive
# via sed substitution — without it the browser refuses every Sentry
# envelope POST and the SDK ships as a silent noop. Default below is
# the SaaS ingest host list; self-hosted operators override.
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=nyx-frontend
# SENTRY_CSP_ORIGIN=https://*.ingest.sentry.io https://*.sentry.io

# LLM / chat (off by default — uncomment LLM_ENABLED=true to expose
# /api/chat). Defaults below are set in code; only override what you
# need. WARNING: never commit real keys; the pre-commit gitleaks
# hook will block the push.
#
# LLM_PROVIDER picks the client implementation:
#   openai  — sashabaranov/go-openai SDK. Works against OpenAI proper
#             (https://api.openai.com/v1) and any OpenAI-compatible
#             server via base URL alone.
#   vllm    — raw net/http + hand-rolled SSE decoder for self-hosted
#             vLLM. Per-dial IP-class allowlist; empty LLM_API_KEY
#             allowed (vLLM started without --api-key accepts any
#             Authorization header, including none).
# The chat domain consumes both through the same llm.Provider
# interface — switching is a config change, no rebuild.
# LLM_ENABLED=true
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-prod-...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60s
# LLM_MAX_TOKENS=1024
# LLM_MAX_HISTORY_MESSAGES=50
# LLM_MAX_MESSAGE_CHARS=32768
# LLM_MAX_STREAM_DURATION=10m
# LLM_SYSTEM_PROMPT=You are a helpful assistant for a movie catalog.
#
# LLM_ALLOW_PRIVATE_URL relaxes the SSRF guard on LLM_BASE_URL
# (loopback / RFC1918 / link-local / multicast / unspecified are
# refused by default). Required when LLM_BASE_URL points at a
# private hostname (dev compose's vLLM container on the bridge
# network, internal staging endpoints). Set to false in prod
# unless you control the upstream network.
# LLM_ALLOW_PRIVATE_URL=false

# HuggingFace API routing inside the vLLM container. Defaults baked
# into docker-compose.yml are: HF_ENDPOINT=https://hf-mirror.com,
# HF_HUB_DISABLE_IPV6=1. Override here only if you want upstream HF
# (HF_ENDPOINT=) or to re-enable IPv6.
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_IPV6=1

# Self-hosted vLLM model. VLLM_MODEL is the HuggingFace repo id
# passed to `vllm serve --model` and is also wired into the backend
# as LLM_MODEL. Default Qwen3-4B-Instruct-2507 is Apache-2.0 and
# ungated; switch to Llama / Mistral requires a token above.
# (Note: VLLM_API_KEY is intentionally absent — the vLLM container
# has no --api-key flag wired, and the backend's vLLM client reads
# LLM_API_KEY, not VLLM_API_KEY.)
# VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# WSL2 GPU-PV workarounds. Only needed when running vLLM on WSL2
# with GPU-PV (driver exposes CUDA via libcuda.so in
# /usr/lib/wsl/lib, no /dev/nvidia*). Without this: "RuntimeError:
# UVA is not available" from vllm/v1/worker/gpu/buffer_utils.py.
# envs.py scopes the flag to "CPU offloading or v2 model runner" but
# in practice it's also required by the v1 staged-writes buffer on
# WSL2. VLLM_USE_V1=0 is NOT a valid fallback — the V0 engine was
# removed in vLLM 0.9 and `VLLM_USE_V1` is no longer in envs.py on
# the 0.29.0 image we pin.
# VLLM_WSL2_ENABLE_PIN_MEMORY=1