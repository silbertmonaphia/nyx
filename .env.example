# Shared infrastructure config — read by `docker-compose` for the
# `db` / `vllm` services and for `${VAR:-default}` substitutions in
# `docker-compose.yml`. NOT consumed by the backend or frontend
# services — those have their own `.env.example` files next to their
# source trees.
#
# Copy to `.env` and fill in. Never commit `.env` (it's in
# `.gitignore`).


# --- Required (no safe default — must be set) ---------------------------

# These are read at startup; the `db` container aborts if they're
# empty. Copy to `.env` and fill in.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nyx

# HuggingFace — REQUIRED for the --profile vllm container. HF's CAS
# endpoint (cas-server.xethub.hf.co) demands a token for all weight
# downloads, even ungated models like the default
# Qwen3-4B-Instruct-2507. Generate at
# https://huggingface.co/settings/tokens (read role is enough).
HUGGING_FACE_HUB_TOKEN=


# --- Optional / has safe defaults (uncomment to override) --------------


# HuggingFace API routing inside the vLLM container. Defaults baked
# into docker-compose.yml are: HF_ENDPOINT=https://hf-mirror.com,
# HF_HUB_DISABLE_IPV6=1. Override here only if you want upstream HF
# (HF_ENDPOINT=) or to re-enable IPv6.
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_IPV6=1

# Self-hosted vLLM model. VLLM_MODEL is the HuggingFace repo id
# passed to `vllm serve --model` and is also wired into the backend
# as LLM_MODEL. Default Qwen3-4B-Instruct-2507 is Apache-2.0 and
# ungated; switch to Llama / Mistral requires a token above.
# (Note: VLLM_API_KEY is intentionally absent — the vLLM container
# has no --api-key flag wired, and the backend's vLLM client reads
# LLM_API_KEY, not VLLM_API_KEY.)
# VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Embedding model served by the optional `vllm-embed` service
# (--profile embed). Qwen/Qwen3-Embedding-0.6B is multilingual
# (100+ languages — matches Chinese queries the chat container
# is asked to handle) and emits 1024-dim vectors (matches
# migration 000015's feed_embeddings.embedding column).
# VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# WSL2 GPU-PV workarounds. Only needed when running vLLM on WSL2
# with GPU-PV (driver exposes CUDA via libcuda.so in
# /usr/lib/wsl/lib, no /dev/nvidia*). Without this: "RuntimeError:
# UVA is not available" from vllm/v1/worker/gpu/buffer_utils.py.
# envs.py scopes the flag to "CPU offloading or v2 model runner" but
# in practice it's also required by the v1 staged-writes buffer on
# WSL2. VLLM_USE_V1=0 is NOT a valid fallback — the V0 engine was
# removed in vLLM 0.9 and `VLLM_USE_V1` is no longer in envs.py on
# the 0.29.0 image we pin.
# VLLM_WSL2_ENABLE_PIN_MEMORY=1
