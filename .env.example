POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nyx
DB_URL=postgres://postgres:postgres@db:5432/nyx?sslmode=disable

# Cache (optional — set REDIS_ENABLED=true to turn caching on)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
CACHE_TTL=5m

# Go module proxy (override if proxy.golang.org is slow from your network)
# Common alternatives: https://goproxy.cn (China), https://goproxy.io (Asia)
GOPROXY=https://goproxy.cn,direct

# Auth — Bearer tokens in JSON body. No cookies, no SameSite, no
# __Host- prefix. The /api/login, /api/register, /api/refresh,
# /api/logout endpoints return {access_token, refresh_token,
# token_type: "Bearer", expires_at, user} in the body; every other
# endpoint expects Authorization: Bearer <access_token>. Native
# clients (iOS / Android / Unity / Unreal / console SDKs) speak the
# identical wire contract.

# CORS — deny-by-default. Empty (default) blocks every cross-origin
# request from a browser. Set this to the explicit comma-separated
# list of frontend origins allowed to call the API. Bearer is a
# regular Authorization header (not a credential), so ACAC is NOT
# needed; the cross-origin preflight is the CSRF defence.
# Dev (Vite on :5173, backend on :8080):
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Prod:
# CORS_ALLOWED_ORIGINS=https://app.nyx.com
CORS_ALLOWED_ORIGINS=

# Frontend → backend origin (cross-origin in production). Baked into
# the SPA bundle at image-build time as VITE_API_URL and into the
# nginx CSP via __API_ORIGIN__.
VITE_API_URL=https://api.nyx.com/api
API_ORIGIN=https://api.nyx.com

# OpenTelemetry — distributed tracing via OTLP/HTTP → Jaeger. Off by default.
# Jaeger UI: http://localhost:16686 — see README.md "OpenTelemetry (optional)".

# OpenTelemetry (backend)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=nyx-backend

# OpenTelemetry (frontend — same-origin /otlp → JAEGER_HOST:4318)
VITE_OTEL_ENABLED=true
VITE_OTEL_SERVICE_NAME=nyx-frontend
JAEGER_HOST=jaeger

# LLM / chat (optional — leave unset to disable the /api/chat endpoint entirely).
# Defaults are set in code; the values below only need to be uncommented when
# LLM_ENABLED=true. WARNING: never commit real keys; the pre-commit gitleaks
# hook will block the push.
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-prod-...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60s
# LLM_MAX_TOKENS=1024
# LLM_MAX_HISTORY_MESSAGES=50
# LLM_MAX_MESSAGE_CHARS=32768
# LLM_MAX_STREAM_DURATION=10m
# LLM_SYSTEM_PROMPT=You are a helpful assistant for a movie catalog.
