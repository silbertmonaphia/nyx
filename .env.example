POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nyx
DB_URL=postgres://postgres:postgres@db:5432/nyx?sslmode=disable

# Cache (optional — set REDIS_ENABLED=true to turn caching on)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
CACHE_TTL=5m

# Go module proxy (override if proxy.golang.org is slow from your network)
# Common alternatives: https://goproxy.cn (China), https://goproxy.io (Asia)
GOPROXY=https://goproxy.cn,direct

# OpenTelemetry — distributed tracing. Off by default; flip on for Jaeger.
#
# OTEL_ENABLED         master switch. false → noop provider, zero overhead.
# OTEL_SERVICE_NAME    stamped on every span as service.name.
# OTEL_EXPORTER_OTLP_ENDPOINT   full URL to the OTLP/HTTP receiver. Scheme
#                              drives TLS: "http://" plaintext, "https://" TLS.
#                              There is intentionally NO separate insecure flag
#                              — mixing one in could downgrade https → http.
#
# Compose example: `docker compose up jaeger backend` already sets
# OTEL_ENABLED=true and OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318.
# For bare `go run ./cmd/api` against a local Jaeger all-in-one on 4318,
# set OTEL_ENABLED=true (defaults work).
#
# Standard OTel SDK env vars (read natively by the SDK, not by viper):
#   OTEL_TRACES_SAMPLER        — "always_on" | "always_off" | "traceidratio" | ...
#   OTEL_TRACES_SAMPLER_ARG    — argument for ratio samplers (e.g. "0.1" = 10%)
#   OTEL_RESOURCE_ATTRIBUTES   — extra resource attrs, e.g. "deployment.environment=staging"
#
# Jaeger UI: http://localhost:16686

OTEL_ENABLED=false
OTEL_SERVICE_NAME=nyx-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
