POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nyx
DB_URL=postgres://postgres:postgres@db:5432/nyx?sslmode=disable

# Cache (optional — set REDIS_ENABLED=true to turn caching on)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
CACHE_TTL=5m

# Go module proxy (override if proxy.golang.org is slow from your network)
# Common alternatives: https://goproxy.cn (China), https://goproxy.io (Asia)
GOPROXY=https://goproxy.cn,direct

# Auth cookies. Defaults are deny-by-default per CLAUDE.md's safety
# convention: Secure=true + SameSite=lax + __Host- name prefix. The
# __Host- prefix requires Secure (HTTPS) so dev over http requires
# COOKIE_SECURE=false (the helper drops the prefix automatically).
# Set COOKIE_SAMESITE=strict for a stricter session cookie (top-level
# navigation no longer carries it). SameSite=none requires COOKIE_SECURE=true.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# COOKIE_ACCESS_NAME=__Host-nyx-access
# COOKIE_REFRESH_NAME=__Host-nyx-refresh

# CORS — deny-by-default. Empty (default) blocks every cross-origin
# request from a browser; the same-origin Vite proxy in dev keeps the
# SPA unaffected. Set this to the explicit comma-separated list of
# frontend origins that should be allowed to call the API. Use "*"
# ONLY for fully public credential-less APIs (and never with cookies
# or the Authorization header — the CORS spec forbids that combo).
# Dev (Vite on http://localhost:5173, hits backend via /api proxy → leave empty):
# CORS_ALLOWED_ORIGINS=
# Staging example:
# CORS_ALLOWED_ORIGINS=https://staging.example.com
# Prod example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# OpenTelemetry — distributed tracing via OTLP/HTTP → Jaeger. Off by default.
# Jaeger UI: http://localhost:16686 — see README.md "OpenTelemetry (optional)".

# OpenTelemetry (backend)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=nyx-backend

# OpenTelemetry (frontend — same-origin /otlp → JAEGER_HOST:4318)
VITE_OTEL_ENABLED=true
VITE_OTEL_SERVICE_NAME=nyx-frontend
JAEGER_HOST=jaeger
