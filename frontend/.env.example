# Frontend config — consumed by Vite (local dev) and the frontend
# Docker image at build time.
#
# In local dev: Vite reads this file automatically (Vite convention
# — `frontend/.env` is loaded by `import.meta.env` at dev time).
#
# In Docker: the frontend service in `docker-compose.yml` reads this
# via `env_file: frontend/.env` at runtime, and the build args default
# to dev values. For production overrides, set the env vars in your
# shell before `docker compose build` (e.g.
# `VITE_API_URL=https://api.nyx.com/api docker compose build`).
#
# Copy to `frontend/.env` and fill in. Never commit `frontend/.env`
# (it's in `.gitignore`).


# --- Frontend → backend origin (cross-origin in production) ------------

# Baked into the SPA bundle at image-build time as `VITE_API_URL`
# (axios baseURL) and into the nginx CSP via the `__API_ORIGIN__`
# placeholder. Frontend falls back to `http://localhost:8080/api` in
# dev when `VITE_API_URL` is unset (see `frontend/src/services/api.ts`).
# VITE_API_URL=https://api.nyx.com/api
# API_ORIGIN=https://api.nyx.com


# --- OpenTelemetry — distributed tracing via OTLP/HTTP → Jaeger --------

# Off by default; uncommenting `VITE_OTEL_ENABLED` enables browser
# span export through the SPA container's nginx `/otlp/` proxy →
# Jaeger (same-origin, bypasses Jaeger's missing CORS).
# `service.name=nyx-frontend` for browser spans.
# VITE_OTEL_ENABLED=true
# VITE_OTEL_SERVICE_NAME=nyx-frontend


# --- Sentry — frontend error / performance / replay sink ----------------

# Backend stays on OTel→Jaeger (see SENTRY.md).
#
# VITE_SENTRY_DSN is inlined into the SPA bundle at build time.
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are build-time only
# — consumed by `@sentry/vite-plugin` for sourcemap upload and never
# shipped to the bundle. Leave the three build-time vars empty for
# local dev builds without upload.
#
# SENTRY_CSP_ORIGIN feeds the nginx CSP `connect-src` directive via
# the `__SENTRY_CSP_ORIGIN__` placeholder; without it the browser
# refuses every Sentry envelope POST and the SDK ships as a silent
# noop. Default below is the SaaS ingest host list — self-hosted
# operators override.
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=nyx-frontend
# SENTRY_CSP_ORIGIN=https://*.ingest.sentry.io https://*.sentry.io
