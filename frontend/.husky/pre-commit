#!/usr/bin/env sh
# SECURITY.md L10: scan staged changes for secrets before they
# land. Runs gitleaks against the staged diff and fails the hook
# on any finding. The CI gitleaks workflow (.github/workflows/
# gitleaks.yml) does the same against the full history — pre-commit
# is the developer-side fast path so a leak never even reaches a
# remote branch.
#
# The hook runs lint-staged AFTER gitleaks so a secret regression
# blocks eslint/vitest from running (no point running tests on a
# commit that's about to be rejected). Gitleaks is invoked via
# `npx --no-install` so the developer must have it in their dev
# dependencies; the alternative (downloading on every commit) is
# both slow and a supply-chain risk.
. "$(dirname -- "$0")/_/husky.sh"

# Gitleaks pre-commit (SECURITY.md L10):
#   --no-git         operate on the working tree (not the repo
#                    history) so the scan is fast.
#   --staged         only scan staged files.
#   --redact         mask found secrets in the report so the
#                    terminal log doesn't echo the secret back
#                    to the developer.
#   --verbose        show what was scanned so the developer can
#                    verify the right files were checked.
# Exits non-zero on any finding → hook fails → commit is rejected.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --verbose
else
  # npx --no-install fails fast (no network) if gitleaks is not
  # in the local node_modules; the CI workflow still catches leaks
  # server-side. This is the developer-experience trade-off: we
  # don't block commits when the developer hasn't installed
  # gitleaks locally, but the server-side scan is the real
  # gate.
  echo "warning: gitleaks not installed; pre-commit scan skipped"
  echo "  install with: brew install gitleaks  OR  apt-get install gitleaks"
  echo "  CI still scans (see .github/workflows/gitleaks.yml)"
fi

cd frontend && npx lint-staged