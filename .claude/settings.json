{
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go run *)",
      "Bash(go mod *)",
      "Bash(SKIP_CONTAINERS=true go test *)",
      "Bash(golangci-lint run *)",
      "Bash(make sqlc*)",
      "Bash(make *)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(mkdir -p *)",
      "Bash(cd backend && *)",
      "Bash(cd frontend && *)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)",
      "Read(**/db_data/**)",
      "Read(**/*.log)",
      "Read(**/.env*)"
    ]
  }
}
