{
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w \"$CLAUDE_PROJECT_DIR/scripts/notify.ps1\")\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); case \"$cmd\" in *clear_all*) printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"会向所有 Claude pane 发送 /clear，请确认\"}}';; esac"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/post-turn-reminder.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(go vet *)",
      "Bash(go fmt *)",
      "Bash(go mod *)",
      "Bash(gofmt *)",
      "Bash(SKIP_CONTAINERS=true go test *)",
      "Bash(golangci-lint *)",
      "Bash(make up)",
      "Bash(make status)",
      "Bash(make logs*)",
      "Bash(make coverage*)",
      "Bash(make sqlc*)",

      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run dev*)",
      "Bash(npm run test*)",
      "Bash(npm run openapi*)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",

      "Bash(curl -s http://localhost*)",
      "Bash(curl -sS http://localhost*)",
      "Bash(curl *https://github.com/*)",
      "Bash(curl *https://raw.githubusercontent.com/*)",
      "Bash(wget *https://github.com/*)",
      "Bash(wget *https://raw.githubusercontent.com/*)",
      "Bash(git clone https://github.com/*)",
      "Bash(git clone git@github.com*)",

      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(mkdir -p *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list*)",

      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",

      "Bash(sudo docker compose up *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps)",
      "Bash(docker ps)",
      "Bash(docker build *)",
      "Bash(sudo docker build *)",

      "Bash(python3 -m venv*)",
      "Bash(backend/agent_py/.venv/bin/python *)",
      "Bash(backend/agent_py/.venv/bin/pip *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pip *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(unlink *)",
      "Bash(rmdir *)",
      "Bash(\\rm *)",
      "Bash(/bin/rm *)",
      "Bash(/usr/bin/rm *)",
      "Bash(/usr/bin/unlink *)",
      "Bash(chmod 777 *)",
      "Bash(env)",
      "Bash(printenv*)",
      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Edit(**/.env*)",
      "Edit(!**/.env.example)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(npm publish*)",
      "Bash(docker compose down*)",
      "Bash(docker system prune*)",
      "Bash(psql *)",
      "Bash(dropdb *)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)",
      "Read(**/db_data/**)",
      "Read(**/k8s/secrets.yaml)",
      "Read(**/*.log)",
      "Edit(backend/internal/**/db/**)"
    ]
  }
}
