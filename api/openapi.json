{
  "components": {
    "schemas": {
      "AuthResponse": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "examples": [
              "Bearer"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "user"
        ],
        "type": "object"
      },
      "ConfigResponse": {
        "additionalProperties": false,
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "embedding": {
            "$ref": "#/components/schemas/LlmEndpointResponse"
          },
          "fallback": {
            "$ref": "#/components/schemas/LlmEndpointResponse"
          },
          "llm": {
            "$ref": "#/components/schemas/LlmEndpointResponse"
          },
          "tavily": {
            "$ref": "#/components/schemas/TavilyResponse"
          }
        },
        "required": [
          "configured",
          "llm",
          "embedding",
          "tavily",
          "fallback"
        ],
        "type": "object"
      },
      "ConfigUpdateInput": {
        "additionalProperties": false,
        "properties": {
          "embedding": {
            "$ref": "#/components/schemas/LlmEndpointInput",
            "description": "Optional embedding group. When omitted the agent runs without feed retrieval (RAG) and feed indexing is skipped."
          },
          "fallback": {
            "$ref": "#/components/schemas/LlmEndpointInput",
            "description": "Optional retry-model group. Supply all three fields or omit the section entirely."
          },
          "llm": {
            "$ref": "#/components/schemas/LlmEndpointInput",
            "description": "Optional main-LLM group. Required for the AI Agent; without it feeds and other features keep working."
          },
          "tavily": {
            "$ref": "#/components/schemas/TavilyInput",
            "description": "Optional search provider group. When omitted the agent does not plan web searches."
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "format": "int64",
            "type": "integer"
          },
          "details": {},
          "error": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ],
        "type": "object"
      },
      "Feed": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "deleted_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "user_id",
          "title",
          "description",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "FeedInput": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 1000,
            "type": "string"
          },
          "title": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "FeedsPage": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Feed"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "has_more": {
            "examples": [
              true
            ],
            "type": "boolean"
          },
          "page": {
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "page_size": {
            "examples": [
              20
            ],
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "examples": [
              42
            ],
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "data",
          "page",
          "page_size",
          "total",
          "has_more"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "services": {
            "$ref": "#/components/schemas/HealthServices"
          },
          "status": {
            "description": "Overall status: 'ok' when the database is reachable, 'error' otherwise.",
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "services"
        ],
        "type": "object"
      },
      "HealthServices": {
        "additionalProperties": false,
        "properties": {
          "api": {
            "examples": [
              "up"
            ],
            "type": "string"
          },
          "cache": {
            "description": "Active cache implementation: 'redis' or 'noop'.",
            "examples": [
              "redis"
            ],
            "type": "string"
          },
          "cache_ping": {
            "description": "Cache probe result: 'ok' or 'fail'.",
            "examples": [
              "ok"
            ],
            "type": "string"
          },
          "database": {
            "examples": [
              "up"
            ],
            "type": "string"
          }
        },
        "required": [
          "api",
          "database",
          "cache",
          "cache_ping"
        ],
        "type": "object"
      },
      "LivezResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Always 'ok' as long as the process is serving HTTP.",
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LlmEndpointInput": {
        "additionalProperties": false,
        "properties": {
          "api_key": {
            "description": "Write-only API key. Required on create; leave empty on update to keep the stored key.",
            "type": "string",
            "writeOnly": true
          },
          "base_url": {
            "description": "OpenAI-compatible base URL including the provider's version prefix (for example, a trailing /v1). Private and localhost addresses are allowed.",
            "type": "string"
          },
          "model": {
            "description": "Model name as the configured endpoint expects it.",
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "model"
        ],
        "type": "object"
      },
      "LlmEndpointResponse": {
        "additionalProperties": false,
        "properties": {
          "api_key_masked": {
            "description": "Masked preview of the stored key: the last four characters only. The plaintext key is write-only and never returned.",
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "model",
          "api_key_masked"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 128,
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "LogoutRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 6,
            "type": "string"
          },
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "TavilyInput": {
        "additionalProperties": false,
        "properties": {
          "api_key": {
            "description": "Write-only API key. Optional: an empty key uses the provider's keyless tier; on update, empty keeps the stored key.",
            "type": "string",
            "writeOnly": true
          },
          "base_url": {
            "description": "Search provider base URL. Omit the whole section to run without web search.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TavilyResponse": {
        "additionalProperties": false,
        "properties": {
          "api_key_masked": {
            "description": "Masked preview of the stored key: the last four characters only. The plaintext key is write-only and never returned.",
            "type": "string"
          },
          "base_url": {
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "api_key_masked"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "deleted_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "JWT bearer token issued by POST /api/login or POST /api/register.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Minimalist feed application API.",
    "title": "Nyx API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/feeds": {
      "get": {
        "description": "Returns a paginated list of feeds owned by the authenticated caller, optionally filtered by a search term matched against title and description.",
        "operationId": "get-feeds",
        "parameters": [
          {
            "description": "Case-insensitive search term matched against title and description.",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Case-insensitive search term matched against title and description.",
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "description": "1-based page index.",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "1-based page index.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items per page; clamped to a server-side maximum of 100.",
            "explode": false,
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "description": "Items per page; clamped to a server-side maximum of 100.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Sort direction: 'desc' returns newest first (default), 'asc' returns oldest first.",
            "explode": false,
            "in": "query",
            "name": "order",
            "schema": {
              "default": "desc",
              "description": "Sort direction: 'desc' returns newest first (default), 'asc' returns oldest first.",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedsPage"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List feeds",
        "tags": [
          "feeds"
        ]
      },
      "post": {
        "description": "Creates a new feed record. Requires a valid JWT in the Authorization header.",
        "operationId": "create-feed",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create a feed",
        "tags": [
          "feeds"
        ]
      }
    },
    "/api/feeds/{id}": {
      "delete": {
        "description": "Soft-deletes a feed record. Requires a valid JWT.",
        "operationId": "delete-feed",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Delete a feed",
        "tags": [
          "feeds"
        ]
      },
      "get": {
        "description": "Returns a single feed owned by the authenticated caller. Returns 404 if the feed does not exist OR is owned by another user — single sentinel, no existence leak.",
        "operationId": "get-feed",
        "parameters": [
          {
            "description": "Feed id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Feed id.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get a feed",
        "tags": [
          "feeds"
        ]
      },
      "put": {
        "description": "Updates the title or description of an existing feed. Requires a valid JWT.",
        "operationId": "update-feed",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Update a feed",
        "tags": [
          "feeds"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Deep readiness check — reports the status of the API, the database connection, and the cache (active implementation and probe result).",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Health check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/livez": {
      "get": {
        "description": "Shallow liveness check — returns 200 as long as the process is up. Does NOT probe the database or cache; use /api/health for a deep readiness signal.",
        "operationId": "livez",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivezResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/login": {
      "post": {
        "description": "Authenticate a user by username + password. The response body carries the access token, refresh token, token type, expiry, and user profile.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Login a user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/logout": {
      "post": {
        "description": "Revoke the refresh token identified in the request body and every rotated token in its family. Requires a valid access token in the Authorization header. Returns 204.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Logout a user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/logout-all": {
      "post": {
        "description": "Revoke every active refresh token for the authenticated user. Access tokens already issued remain valid until they expire (at most the configured access TTL, default 15m). Requires a valid access token in the Authorization header. Returns 204.",
        "operationId": "logout-all",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Logout all sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me": {
      "get": {
        "description": "Return the profile of the authenticated user (the access token's subject). Used by the SPA to reconcile its persisted user on every page load.",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get current user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me/llm-config": {
      "delete": {
        "description": "Removes the authenticated caller's LLM configuration. Idempotent: deleting an unconfigured user also returns 204.",
        "operationId": "delete-llm-config",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Delete LLM configuration",
        "tags": [
          "llm-config"
        ]
      },
      "get": {
        "description": "Returns the authenticated caller's per-user LLM configuration with API keys masked to their last four characters. A user with no saved configuration receives configured=false with null sections.",
        "operationId": "get-llm-config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get LLM configuration",
        "tags": [
          "llm-config"
        ]
      },
      "put": {
        "description": "Validates and upserts the authenticated caller's optional main LLM, optional embedding, optional Tavily, and optional retry-model configuration. API keys are write-only: a blank key on update keeps the stored key; on create a key is required unless the endpoint is loopback. Omitting Tavily disables web search for the agent. Responds with the masked configuration.",
