# SECURITY.md L10: scan staged changes for secrets before they
# land. CI (.github/workflows/gitleaks.yml) is the authoritative
# gate; this hook is the developer-side fast path so a leak never
# reaches a remote branch.
#
# Gitleaks is optional locally — a missing install only prints a
# warning and skips the scan. The CLI flags:
#   --no-git    scan the working tree, not the repo history (fast)
#   --staged    only scan staged files
#   --redact    mask found secrets so the terminal log doesn't
#               echo the secret back to the developer
#   --verbose   show what was scanned
# Exits non-zero on any finding → hook fails → commit rejected.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --verbose
else
  echo "warning: gitleaks not installed; pre-commit scan skipped"
  echo "  install with: brew install gitleaks  OR  apt-get install gitleaks"
  echo "  CI still scans (see .github/workflows/gitleaks.yml)"
fi

# lint-staged config lives at lint-staged.config.cjs at the repo
# root; patterns are repo-relative (e.g. `frontend/src/**`,
# `frontend/package.json`). Run the binary directly from the repo
# root so pattern matching sees staged paths as repo-relative
# strings and minimatch resolves them correctly — running from
# `frontend/` instead would make lint-staged see staged files as
# absolute paths (`/home/smona/nyx/frontend/package.json`) and the
# repo-relative patterns would silently fail to match (the original
# `cd frontend && npx lint-staged` form had this bug; Sentry commit
# 1258285 went through without lint-staged actually verifying
# anything). The frontend/src tasks themselves prefix `cd frontend
# &&` so eslint/vitest resolve their devDeps from
# frontend/node_modules despite lint-staged running from the repo
# root. lint-staged itself is a frontend-only devDep, so the binary
# path is relative to that package.
./frontend/node_modules/.bin/lint-staged
